{
 "cleanUrls": true,
 "trailingSlash": false,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=()"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=63072000; includeSubDomains"
    }
   ]
  },
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/(support|hover|image-slot).js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  },
  {
   "source": "/(.*).dc.html",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=60, stale-while-revalidate=604800"
    }
   ]
  },
  {
   "source": "/",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=60, stale-while-revalidate=604800"
    }
   ]
  },
  {
   "source": "/(inventory|vehicle|sell-or-trade|our-process|reviews|faq|about)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=60, stale-while-revalidate=604800"
    }
   ]
  },
  {
   "source": "/inventory.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=60, stale-while-revalidate=604800"
    }
   ]
  }
 ]
}